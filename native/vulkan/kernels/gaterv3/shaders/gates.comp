#version 450
#extension GL_GOOGLE_include_directive : require
#include "schedule.glsl"

layout(local_size_x = 64) in;
layout(constant_id = 0) const bool useInception = false;

vec2 loadPair(int offset) {
    return vec2(loadActivation(offset), loadActivation(offset + 1));
}

vec2 localGate(int pixel, int x, int y, int c) {
    int channels = op.outputChannels;
    int stride = 2 * channels;
    vec2 left = weightPair(op.weights.y, c);
    vec2 right = weightPair(op.weights.y, c + channels);
    for (int dy = -1; dy <= 1; ++dy) {
        if (y + dy < 0 || y + dy >= op.h) continue;
        for (int dx = -1; dx <= 1; ++dx) {
            if (x + dx < 0 || x + dx >= op.w) continue;
            int pos = op.offsets.x + (pixel + dy * op.w + dx) * stride + c;
            int tap = ((dy + 1) * 3 + dx + 1) * 2 * stride + c;
            vec2 a = loadPair(pos);
            vec2 b = loadPair(pos + channels);
            left = fma(vec2(a.x), weightPair(op.weights.x, tap), left);
            left = fma(vec2(a.y), weightPair(op.weights.x, tap + stride), left);
            right = fma(vec2(b.x), weightPair(op.weights.x, tap + channels), right);
            right = fma(vec2(b.y), weightPair(op.weights.x, tap + stride + channels), right);
        }
    }
    return left * right;
}

vec2 branchConv(int pixel, int x, int y, int c, int band, int part, int kw, int kh, int offset) {
    int branch = part * band + c % band;
    vec2 result = weightPair(op.weights.y, branch);
    int base = op.offsets.x + pixel * op.channels.x + op.outputChannels + c;
    int tapBase = offset * band + c % band;
    for (int dy = -kh / 2; dy <= kh / 2; ++dy) {
        if (y + dy < 0 || y + dy >= op.h) continue;
        for (int dx = -kw / 2; dx <= kw / 2; ++dx) {
            if (x + dx < 0 || x + dx >= op.w) continue;
            int tap = (dy + kh / 2) * kw + dx + kw / 2;
            vec2 inputValues = loadPair(base + (dy * op.w + dx) * op.channels.x);
            result = fma(inputValues, weightPair(op.weights.x, tapBase + tap * band), result);
        }
    }
    return result;
}

vec2 inceptionGate(int pixel, int x, int y, int c) {
    int hidden = op.outputChannels;
    int band = hidden / 12;
    int base = op.offsets.x + pixel * op.channels.x + c;
    vec2 values;
    if (c < hidden - 3 * band) values = loadPair(base + hidden);
    else if (c < hidden - 2 * band) values = branchConv(pixel, x, y, c, band, 0, 3, 3, 0);
    else if (c < hidden - band) values = branchConv(pixel, x, y, c, band, 1, 11, 1, 9);
    else values = branchConv(pixel, x, y, c, band, 2, 1, 11, 20);
    vec2 gate = loadPair(base);
    return vec2(mish(gate.x), mish(gate.y)) * values;
}

void main() {
    int i = 2 * (64 * groupIndex() + int(gl_LocalInvocationIndex));
    int p = i / op.outputChannels;
    if (p >= op.batch * op.h * op.w) return;
    int c = i % op.outputChannels;
    int x = p % op.w;
    int y = p / op.w % op.h;
    vec2 value = useInception ? inceptionGate(p, x, y, c) : localGate(p, x, y, c);
    storeActivation(op.outputOffset + i, value.x);
    storeActivation(op.outputOffset + i + 1, value.y);
}
